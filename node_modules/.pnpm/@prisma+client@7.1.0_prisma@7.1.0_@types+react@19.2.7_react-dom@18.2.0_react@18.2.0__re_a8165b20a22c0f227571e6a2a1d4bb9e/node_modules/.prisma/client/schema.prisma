generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     String   @unique
  createdAt DateTime @default(now())

  apiKeys ApiKey[]
  ledger  LedgerAccount?
}

model ApiKey {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String    @unique
  owner     String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [owner], references: [owner], onDelete: Cascade)
}

model LedgerAccount {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  user   User          @relation(fields: [owner], references: [owner], onDelete: Cascade)
  events LedgerEvent[]
}

model LedgerEvent {
  id        String          @id @default(uuid())
  owner     String
  amount    Int
  reason    String
  type      LedgerEventType
  createdAt DateTime        @default(now())

  account LedgerAccount @relation(fields: [owner], references: [owner], onDelete: Cascade)
}

enum LedgerEventType {
  CREDIT
  DEBIT
}

model TaskExecution {
  id             String              @id @default(uuid())
  owner          String
  taskType       String
  idempotencyKey String              @unique
  status         TaskExecutionStatus
  cost           Int
  result         String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([owner])
}

enum TaskExecutionStatus {
  PENDING
  SUCCESS
  FAILED
}
