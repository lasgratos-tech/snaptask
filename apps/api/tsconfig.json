{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "sourceMap": true,
    "skipLibCheck": true,

    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
  "node_modules",
  "dist",
  "src/auth/googleOAuth.ts",
  "src/auth/oauthCallback.ts",
  "src/infra/commandPersistence.ts",
  "src/infra/eventStore.ts"
]

}
