generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
///  * =========================
///  * USERS
///  * =========================
model User {
  id        String         @id
  owner     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  apiKeys   ApiKey[]
  ledger    LedgerAccount?

  @@map("User")
}

/// *
///  * =========================
///  * API KEYS
///  * =========================
model ApiKey {
  id        String    @id @default(uuid())
  key       String    @unique
  owner     String
  role      String    @default("client")
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [owner], references: [owner], onDelete: Cascade)

  @@index([owner])
}

/// *
///  * =========================
///  * LEDGER ACCOUNT (BALANCE)
///  * =========================
model LedgerAccount {
  id        String        @id @default(uuid())
  owner     String        @unique
  balance   Int           @default(0)
  updatedAt DateTime
  user      User          @relation(fields: [owner], references: [owner], onDelete: Cascade)
  events    LedgerEvent[]

  @@map("LedgerAccount")
}

/// *
///  * =========================
///  * LEDGER EVENTS (HIGH LEVEL)
///  * =========================
model LedgerEvent {
  id        String          @id
  owner     String
  amount    Int
  reason    String
  type      LedgerEventType
  createdAt DateTime        @default(now())
  account   LedgerAccount   @relation(fields: [owner], references: [owner], onDelete: Cascade)

  @@index([owner])
  @@map("LedgerEvent")
}

enum LedgerEventType {
  CREDIT
  DEBIT
}
