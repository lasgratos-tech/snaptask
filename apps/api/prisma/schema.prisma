generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
///  * =========================
///  * USERS
///  * =========================
model User {
  id            String         @id
  owner         String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  apiKeys       ApiKey[]
  ledger        LedgerAccount?
  taskExecutions TaskExecution[]

  @@map("User")
}

/// *
///  * =========================
///  * API KEYS
///  * =========================
model ApiKey {
  id        String    @id @default(uuid())
  key       String    @unique
  owner     String
  role      String    @default("client")
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [owner], references: [owner], onDelete: Cascade)

  @@index([owner])
}

/// *
///  * =========================
///  * LEDGER ACCOUNT (BALANCE)
///  * =========================
model LedgerAccount {
  id        String        @id @default(uuid())
  owner     String        @unique
  balance   Int           @default(0)
  updatedAt DateTime
  user      User          @relation(fields: [owner], references: [owner], onDelete: Cascade)
  events    LedgerEvent[]

  @@map("LedgerAccount")
}

/// *
///  * =========================
///  * LEDGER EVENTS (HIGH LEVEL)
///  * =========================
model LedgerEvent {
  id        String          @id
  owner     String
  amount    Int
  reason    String
  type      LedgerEventType
  createdAt DateTime        @default(now())
  account   LedgerAccount   @relation(fields: [owner], references: [owner], onDelete: Cascade)

  @@index([owner])
  @@map("LedgerEvent")
}

enum LedgerEventType {
  CREDIT
  DEBIT
}

/// *
///  * =========================
///  * TASK EXECUTION
///  * =========================
model TaskExecution {
  id              String   @id @default(uuid())
  userOwner       String
  taskCode        String
  status          String
  paymentIntentId String?  @unique
  idempotencyKey  String   @unique
  outputPath      String?
  createdAt       DateTime @default(now())
  executedAt      DateTime?

  user User @relation(fields: [userOwner], references: [owner], onDelete: Cascade)

  @@index([userOwner])
  @@map("TaskExecution")
}
